{
  "name": "hinotike",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv .env.development",
    "dev:tunnel": "DEV_ALLOWED_HOSTS=desktop1.sakurastyle.jp NUXT_PUBLIC_APP_URL=https://desktop1.sakurastyle.jp nuxt dev",
    "build": "nuxt build",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "preview": "nuxt preview",
    "icons": "node scripts/render-icons.mjs",
    "postinstall": "nuxt prepare",
    "sync:sheets": "tsx scripts/sync-sheets.ts",
    "sync:sheets:local": "tsx scripts/sync-sheets.ts --env .env.development",
    "deploy:cf": "nuxt build && npx wrangler deploy",
    "preview:cf": "npx wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "node scripts/test-local.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:dev-user": "node scripts/create-dev-user.mjs"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.9",
    "@supabase/supabase-js": "^2.45.0",
    "nuxt": "^4.0.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "^1.1.1",
    "@zxing/library": "^0.23.0",
    "googleapis": "^140.0.0",
    "playwright-core": "^1.65.0",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true
  }
}
