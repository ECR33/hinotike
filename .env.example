# @nuxtjs/supabase モジュール設定(クライアント/サーバー共通。公開用 publishable key のみ)
NUXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_your-publishable-key

# 本番の公開 baseUrl(Cloudflare tunnel 等の外部ホスト)。未設定ならリクエストの Host から導出。
# OAuth のリダイレクトURL組み立てに使う: <appUrl>/api/auth-callback を Redirect URLs に登録する。
NUXT_PUBLIC_APP_URL=https://your-site.example.com

# 開発サーバー(Vite)で許可する外部ホスト名。すべて環境変数から(nuxt.config にハードコードしない)。
# カンマ区切り / 単一ホストなら NUXT_VITE_ALLOWED_HOST でも可。
DEV_ALLOWED_HOSTS=
NUXT_VITE_ALLOWED_HOST=

# Google Sheets 同期(本体は UI の /sync。Worker の secret に鍵 JSON を置く。アプリ自体は secret key を使わない)。
# CLI の同期(npm run sync:sheets)は鍵を「パス」または「JSON 文字列」のどちらでも読める。
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./scripts/service-account.json
# Worker/本番の secret 名はこちら(JSON 文字列)。ローカル dev の Worker は .dev.vars に置く。
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# ↑ は sync_settings の行が空のときのフォールバックのみ。通常は /sync の設定画面から ID を保存する。
SUPABASE_URL=上記 URL と同じ
SUPABASE_SECRET_KEY=sb_secret_...(ダッシュボードの Secret key。CLI の同期専用。公開しない・Worker に置かない)
SUPABASE_TABLE_NAME=items

# ローカル Supabase(supabase start)での開発・統合テスト用。
# dev モードでは .env.development(ローカル dev デフォルトキー入り)が自動で読み込まれ .env を上書きする。
# 統合テストは `npm run test:local`(起動中のローカル Supabase のキーを自動取得して実行)。
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_SECRET_KEY=...
